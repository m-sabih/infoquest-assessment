# PostgreSQL (required for ingestion)
DATABASE_URL=postgresql://developer:CHANGE_ME@host:5432/candidate_profiles

# OpenRouter (required for /ingest embeddings)
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-large
CHAT_MODEL=openai/gpt-5.4
CHAT_CHECKPOINT_PATH=./data/langgraph/checkpoints.sqlite

# Chroma persistence
CHROMA_PATH=./data/chroma
COLLECTION_NAME=candidates

# Ingestion tuning
CANDIDATE_PAGE_SIZE=200
EMBEDDING_BATCH_SIZE=24
MAX_PROFILE_CHARS=24000

# API
APP_NAME=InfoQuest Expert Search API
